@Tutorials(name: "Building with Shikisha") {
    @Intro(title: "Build with Shikisha") {
        Learn Shikisha by building three small, real apps: a streaming chatbot with memory, a
        retrieval-augmented "chat with your data" app, and a tool-using agent. Each tutorial is
        self-contained and builds up one step at a time.

        New to the concepts? Read <doc:LLMAppPrimer> first.

        @Image(source: "overview.png", alt: "The Shikisha logo and wordmark above the five tutorials — streaming chatbot, RAG app, tool-using agent, coding agent, and SwiftUI chat app")
    }

    @Chapter(name: "Hands-on Shikisha") {
        Start with a chatbot, then ground answers in your own data, then let the model take
        actions through tools.

        @Image(source: "overview.png", alt: "The five Shikisha tutorials shown as a connected journey from chatbot to SwiftUI app")

        @TutorialReference(tutorial: "doc:BuildAChatbot")
        @TutorialReference(tutorial: "doc:BuildARAGApp")
        @TutorialReference(tutorial: "doc:BuildAnAgent")
        @TutorialReference(tutorial: "doc:BuildACodingAgent")
        @TutorialReference(tutorial: "doc:PutYourAgentInASwiftUIApp")
    }

    @Resources {
        Explore more ways to learn and contribute.

        @Documentation(destination: "https://krisbaker.com/Shikisha/documentation/shikisha") {
            Browse the full API reference and conceptual guides.

            - [A Swift Developer's Primer on LLM Apps](<doc:LLMAppPrimer>)
            - [Core Concepts: Runnables and Composition](<doc:CoreConcepts>)
        }

        @SampleCode(destination: "https://github.com/KristopherGBaker/Shikisha/tree/main/Examples") {
            Run the bundled, offline examples with `swift run ShikishaExamples <name>`.

            - [Browse the example sources](https://github.com/KristopherGBaker/Shikisha/tree/main/Examples/ShikishaExamples)
        }
    }
}
